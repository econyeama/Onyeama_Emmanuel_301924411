erDiagram
    CENTRE ||--o{ SEAT             : "houses computers"
    CENTRE ||--o{ EXAM_SESSION     : "hosts sessions"
    EXAM   ||--o{ EXAM_SESSION     : "is delivered in"
    EXAM   ||--o{ REGISTRATION     : "is taken via"
    EXAM_SESSION ||--o{ SEAT_ALLOCATION : "fills seats at"
    SEAT   ||--o{ SEAT_ALLOCATION  : "is assigned in"
    CANDIDATE ||--o{ REGISTRATION   : "creates"
    CANDIDATE ||--o{ SEAT_ALLOCATION: "is booked onto"
    REGISTRATION ||--|| PAYMENT     : "must have one"
    REGISTRATION ||--o{ SEAT_ALLOCATION: "becomes"
    SEAT_ALLOCATION ||--o| RESULT   : "produces"
    CANDIDATE ||--o{ RESULT         : "earns"
    EXAM   ||--o{ RESULT           : "is scored in"

    CENTRE {
        bigint   centre_id      PK
        text     code           UK
        text     name
        text     city
        text     address
        integer  seat_capacity
        timestamptz created_at
    }
    EXAM {
        bigint   exam_id        PK
        text     code           UK
        text     title
        text     body
        text     category
        integer  duration_minutes
        numeric  default_fee
        timestamptz created_at
    }
    EXAM_SESSION {
        bigint   session_id     PK
        bigint   centre_id      FK
        bigint   exam_id        FK
        date     session_date
        timestamptz start_time
        timestamptz end_time
        tstzrange session_range
        numeric  fee
        text     status
    }
    SEAT {
        bigint   seat_id        PK
        bigint   centre_id      FK
        text     seat_number
        text     computer_name
        text     status
    }
    CANDIDATE {
        bigint   candidate_id   PK
        text     first_name
        text     last_name
        text     email           UK
        text     phone           UK
        text     gender
        text     state_of_origin
    }
    REGISTRATION {
        bigint   registration_id PK
        bigint   candidate_id    FK
        bigint   exam_id         FK
        timestamptz registered_at
        text     status
    }
    SEAT_ALLOCATION {
        bigint   allocation_id  PK
        bigint   session_id     FK
        bigint   seat_id        FK
        bigint   candidate_id   FK
        bigint   registration_id FK
        tstzrange session_range
        timestamptz allocated_at
        boolean  checked_in
        boolean  attended
    }
    PAYMENT {
        bigint   payment_id     PK
        bigint   registration_id FK
        numeric  amount
        timestamptz paid_at
        text     status
        text     reference       UK
    }
    RESULT {
        bigint   result_id      PK
        bigint   allocation_id  FK, UK
        bigint   candidate_id   FK
        bigint   exam_id        FK
        numeric  score
        timestamptz graded_at
    }
