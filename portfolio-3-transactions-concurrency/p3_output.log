Demo session 2096 (PMP, TestPoint Lagos, 45 days ahead), seats 1/2/3
Chiamaka Obi = candidate 12065 at Terminal A, Yusuf Danladi = candidate 12066 at Terminal B, Grace Etim = candidate 12067. Everyone wants seat 1.

==========================================================================
  PART 1 — THE BUG: check-then-insert with no unique rule (seat_allocation_bug)
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT count(*) AS seat_holders FROM seat_allocation_bug WHERE session_id = 2096 AND seat_id = 1
       seat_holders
       0
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT count(*) AS seat_holders FROM seat_allocation_bug WHERE session_id = 2096 AND seat_id = 1
       seat_holders
       0
       (1 row)
A   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12065)
       INSERT 0 1
A   > COMMIT
       COMMIT
B   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12066)
       INSERT 0 1
B   > COMMIT
       COMMIT
A   > SELECT bug_id, candidate_id, seat_id FROM seat_allocation_bug WHERE session_id = 2096 ORDER BY bug_id
       bug_id | candidate_id | seat_id
       1 | 12065 | 1
       2 | 12066 | 1
       (2 rows)
  >>> BUG: two candidates now hold the same computer in the same session.

==========================================================================
  PART 2 — FIX 1: a UNIQUE index on (seat_id, session_id)
==========================================================================
A   > TRUNCATE seat_allocation_bug
       TRUNCATE TABLE
A   > CREATE UNIQUE INDEX bug_seat_unique ON seat_allocation_bug (seat_id, session_id)
       CREATE INDEX
A   > BEGIN
       BEGIN
B   > BEGIN
       BEGIN
A   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12065)
       INSERT 0 1
B   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12066)
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       ERROR [23505]: duplicate key value violates unique constraint "bug_seat_unique"
       DETAIL: Key (seat_id, session_id)=(1, 2096) already exists.
B   > ROLLBACK
       ROLLBACK
A   > SELECT bug_id, candidate_id, seat_id FROM seat_allocation_bug WHERE session_id = 2096 ORDER BY bug_id
       bug_id | candidate_id | seat_id
       3 | 12065 | 1
       (1 row)
  >>> FIXED: B waited for A, then got a unique_violation. One holder only.

==========================================================================
  PART 3 — FIX 2: allocate_seat() locks the seat row (SELECT … FOR UPDATE)
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT allocate_seat(2096, 12065, 1, 75000) AS allocation_id
       allocation_id
       116893
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT allocate_seat(2096, 12066, 1, 75000) AS allocation_id
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       ERROR [P0001]: allocate_seat: seat 1 is already allocated in session 2096
B   > ROLLBACK
       ROLLBACK
A   > SELECT allocation_id, candidate_id, seat_id FROM seat_allocation WHERE session_id = 2096 AND seat_id = 1
       allocation_id | candidate_id | seat_id
       116893 | 12065 | 1
       (1 row)
  >>> FIXED: B queued behind A's row lock, then got a clear 'already allocated' message.

==========================================================================
  PART 4 — FIX 3: SERIALIZABLE stops the bug even with NO unique index
==========================================================================
A   > DROP INDEX bug_seat_unique
       DROP INDEX
A   > TRUNCATE seat_allocation_bug
       TRUNCATE TABLE
A   > BEGIN ISOLATION LEVEL SERIALIZABLE
       BEGIN
A   > SELECT count(*) AS seat_holders FROM seat_allocation_bug WHERE session_id = 2096 AND seat_id = 1
       seat_holders
       0
       (1 row)
B   > BEGIN ISOLATION LEVEL SERIALIZABLE
       BEGIN
B   > SELECT count(*) AS seat_holders FROM seat_allocation_bug WHERE session_id = 2096 AND seat_id = 1
       seat_holders
       0
       (1 row)
A   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12065)
       INSERT 0 1
B   > INSERT INTO seat_allocation_bug (session_id, seat_id, candidate_id) VALUES (2096, 1, 12066)
       INSERT 0 1
A   > COMMIT
       COMMIT
B   > COMMIT
       ERROR [40001]: could not serialize access due to read/write dependencies among transactions
       DETAIL: Reason code: Canceled on identification as a pivot, during commit attempt.
A   > SELECT bug_id, candidate_id, seat_id FROM seat_allocation_bug WHERE session_id = 2096 ORDER BY bug_id
       bug_id | candidate_id | seat_id
       5 | 12065 | 1
       (1 row)
  >>> FIXED: both read 'seat free' and both wrote it, so PostgreSQL
      cancelled B with a serialization failure (SQLSTATE 40001).

==========================================================================
  PART 5 — READ COMMITTED vs REPEATABLE READ (counting booked seats)
==========================================================================
-- 5a: READ COMMITTED (the default)
A   > BEGIN ISOLATION LEVEL READ COMMITTED
       BEGIN
A   > SELECT count(*) AS seats_booked FROM seat_allocation WHERE session_id = 2096
       seats_booked
       1
       (1 row)
B   > SELECT allocate_seat(2096, 12066, 2, 75000) AS allocation_id
       allocation_id
       116894
       (1 row)
A   > SELECT count(*) AS seats_booked FROM seat_allocation WHERE session_id = 2096
       seats_booked
       2
       (1 row)
A   > COMMIT
       COMMIT
  >>> A saw the count change inside ONE transaction (non-repeatable read).
-- 5b: REPEATABLE READ
A   > BEGIN ISOLATION LEVEL REPEATABLE READ
       BEGIN
A   > SELECT count(*) AS seats_booked FROM seat_allocation WHERE session_id = 2096
       seats_booked
       2
       (1 row)
B   > SELECT allocate_seat(2096, 12067, 3, 75000) AS allocation_id
       allocation_id
       116895
       (1 row)
A   > SELECT count(*) AS seats_booked FROM seat_allocation WHERE session_id = 2096
       seats_booked
       2
       (1 row)
A   > COMMIT
       COMMIT
A   > SELECT count(*) AS seats_booked FROM seat_allocation WHERE session_id = 2096
       seats_booked
       3
       (1 row)
  >>> A kept its snapshot until COMMIT; the new booking appears afterwards.

==========================================================================
  PART 6 — DEADLOCK: two desks lock two seats in opposite order
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT seat_id FROM seat WHERE seat_id = 1 FOR UPDATE
       seat_id
       1
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT seat_id FROM seat WHERE seat_id = 2 FOR UPDATE
       seat_id
       2
       (1 row)
A   > SELECT seat_id FROM seat WHERE seat_id = 2 FOR UPDATE
A     ... still WAITING for a lock held by the other terminal
B   > SELECT seat_id FROM seat WHERE seat_id = 1 FOR UPDATE
       ERROR [40P01]: deadlock detected
       DETAIL: Process 25950 waits for ShareLock on transaction 956; blocked by process 25949.
       DETAIL: Process 25949 waits for ShareLock on transaction 957; blocked by process 25950.
A     ... the waiting statement has now finished:
       seat_id
       2
       (1 row)
A   > ROLLBACK
       ROLLBACK
B   > ROLLBACK
       ROLLBACK
  >>> PostgreSQL detected the cycle after deadlock_timeout (1s) and
      aborted one transaction (SQLSTATE 40P01) so the other could go on.
-- 6b: the fix — always lock seats in seat_id order
A   > BEGIN
       BEGIN
A   > SELECT seat_id FROM seat WHERE seat_id IN (1, 2) ORDER BY seat_id FOR UPDATE
       seat_id
       1
       2
       (2 rows)
B   > BEGIN
       BEGIN
B   > SELECT seat_id FROM seat WHERE seat_id IN (1, 2) ORDER BY seat_id FOR UPDATE
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       seat_id
       1
       2
       (2 rows)
B   > COMMIT
       COMMIT
  >>> Same two locks, same order: B simply waits its turn. No deadlock.

